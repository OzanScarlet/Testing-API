OPENAI_API_KEY= "..."
BASE_URL= "..."
MODEL_NAME= "..."


CHATOPA_URL="..."
CHATOPA_API_KEY="..."


# --- Penyetelan anti-limit ---
CHUNK_CHARS=5000
DELAY=3.0



PHOENIX_BASE_URL="http://localhost:6006"
PHOENIX_PROJECT_NAME=""
PHOENIX_API_KEY=""
# Project trace RAG yang dibaca tab Evaluasi (POST) / find trace
PHOENIX_RETRIEVE_PROJECT="ChatOPA-staging"
# Project sumber trace Watcher Evaluasi Pipeline (tanpa POST)
PHOENIX_PIPELINE_PROJECT="ChatOPA-production"
# Project tujuan trace hasil evaluasi judge
PHOENIX_SEND_PROJECT="AutoAssesment"

# --- Chat Dokumen (RAG lokal) ---
EMBED_MODEL="intfloat/multilingual-e5-small"
RAG_TOP_K=5

# --- Chat Dokumen tracing ---
# Project tujuan trace jawaban Chat Dokumen di Phoenix
DOC_CHAT_PHOENIX_PROJECT=ChatOPA-staging
# OTLP HTTP endpoint Phoenix (default server project)
PHOENIX_COLLECTOR_ENDPOINT=https://phoenix.rpn.my.id/v1/traces
