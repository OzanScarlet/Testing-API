# GROQ (default, free tier dengan limit tinggi)
GROQ_API_KEY=your-groq-api-key-here

# Model untuk generate pertanyaan (model Groq)
# llama-3.1-8b-instant = lebih ringan/cepat, limit gratis lebih longgar
MODEL_NAME=llama-3.1-8b-instant

# Base URL provider; default Groq. Alternatif yang bisa dipakai:
# - OpenAI: BASE_URL=https://api.openai.com/v1 , MODEL_NAME=gpt-4o-mini , OPENAI_API_KEY=...
# - DeepSeek resmi: BASE_URL=https://api.deepseek.com , MODEL_NAME=deepseek-v4-flash , DEEPSEEK_API_KEY=...
# - Relay OpenRouter: BASE_URL=https://openrouter.ai/api/v1 , MODEL_NAME=deepseek/deepseek-v4-flash:free , OPENAI_API_KEY=...
BASE_URL=https://api.groq.com/openai/v1

# Penyetelan anti-limit (bisa diubah tanpa ubah kode):
# CHUNK_CHARS             = ukuran maks chunk per request (makin kecil makin ringan)
# MAX_QUESTIONS_PER_CHUNK = maksimal pertanyaan per chunk (makin kecil makin hemat)
# DELAY                   = jeda antar request dalam detik (makin besar makin aman)
CHUNK_CHARS=5000
MAX_QUESTIONS_PER_CHUNK=10
DELAY=3.0
